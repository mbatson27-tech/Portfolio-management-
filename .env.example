# Copy to .env and fill in. Both are optional: without them the app runs on demo data.

# Claude API key for the AI briefing and chat. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Finnhub key for live quotes and news (free tier: 60 calls/min). https://finnhub.io/register
FINNHUB_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# PORT=3000
