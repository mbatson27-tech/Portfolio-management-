# Copy to .env and fill in. Both are optional: without them the app runs on demo data.

# Claude API key for the AI briefing and chat. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Finnhub key for live quotes and news (free tier: 60 calls/min). https://finnhub.io/register
FINNHUB_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# PORT=3000

# ---- Trading (optional) ----
# Alpaca keys. Without them, trading runs on a simulated $100k account.
# Get free paper-trading keys at https://alpaca.markets (Paper Trading dashboard).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Largest single order the app will place, in USD.
MAX_ORDER_USD=1000
# REAL MONEY: only if you set BOTH of these. Leave them alone to stay on paper trading.
# ALPACA_PAPER=false
# ALLOW_LIVE_TRADING=true
